<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Version>1.4</Version>
		<Authors>Adam Fisher</Authors>
		<Company />
		<Description>A C# wrapper to decay values based on conditions.</Description>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/adamfisher/Decay</PackageProjectUrl>
		<PackageIcon>nuclear_icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/adamfisher/Decay</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>decay, lazy, expire, expiration</PackageTags>

		<!-- Ship XML docs so IntelliSense works for package consumers. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Reproducible builds + source-stepping (SourceLink is built into the .NET 8 SDK). -->
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\nuclear_icon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

</Project>
